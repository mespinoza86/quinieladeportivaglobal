# ============================================================
# Copia este archivo como .env y rellena los valores reales.
# El archivo .env NO debe subirse al repositorio.
# ============================================================

# --- Obligatorias ---

# Cadena de conexión a PostgreSQL. Sin ella el proceso termina con exit(1).
#
# ⚠️ DOS COSAS QUE NO SON OPCIONALES EN PRODUCCIÓN:
#
#   1. El rol tiene que ser `app_quiniela`, NUNCA el dueño de la base. El dueño
#      puede saltarse las políticas de seguridad por fila (RLS), que es lo único
#      que separa una quiniela de otra. Con el rol dueño, el aislamiento entre
#      quinielas deja de existir sin que nada avise.
#
#   2. La cadena tiene que ser la del `-pooler` de Neon, y decir
#      `sslmode=verify-full` de forma explícita: `require` es más débil y puede
#      cambiar de garantías con una actualización.
#
# En local sirve cualquier PostgreSQL; el rol dueño ahí no hace daño porque no
# hay datos de nadie.
DATABASE_URL=postgresql://app_quiniela:clave@host-pooler.neon.tech/quiniela?sslmode=verify-full

# Secreto de firma de las cookies de sesión.
# En producción es obligatorio: el servidor se niega a arrancar sin él.
SESSION_SECRET=cambia-por-un-secreto-largo-y-aleatorio

# Credencial de APIFootball (apiv3.apifootball.com).
# Sin ella, las rutas de importación y sincronización de partidos devuelven 500.
APIFOOTBALL_COM_KEY=

# --- Opcionales ---

# Puerto HTTP. Por defecto 3000.
PORT=3000

# Conexiones máximas del pool. Por defecto 10. En Render el plan gratuito no da
# para mucho más, y Neon cuenta las conexiones del pooler aparte.
DB_MAX_CONEXIONES=10

# Entorno de ejecución: development | production
# ¡CUIDADO CON EL NOMBRE! Debe ser NODE_ENV exactamente.
# En 'production' activa: trust proxy, cookie secure y SESSION_SECRET obligatorio.
NODE_ENV=development

# Orígenes autorizados por CORS, separados por comas.
# Los orígenes locales de desarrollo siempre están permitidos.
# Añade aquí el dominio de producción cuando despliegues.
ALLOWED_ORIGINS=https://quinieladeportivaglobal.onrender.com

# Expone los endpoints /debug/* y /api/debug/*, que devuelven respuestas crudas
# de APIFootball y volcados de jornadas. Con cualquier otro valor responden 404.
# DÉJALO APAGADO EN PRODUCCIÓN.
DEBUG_ENDPOINTS=false

# --- Sincronizador (Fase 4) ---

# Cada cuánto corre un ciclo de sincronización, en milisegundos.
# NO es la frecuencia con que se consulta cada partido: dentro del ciclo, cada
# partido tiene su propia ventana según su estado (terminado nunca, en vivo cada
# minuto, lejano cada seis horas). Bajarlo no aumenta el consumo del API; solo
# hace que las ventanas se revisen antes.
SYNC_INTERVALO_MS=60000

# Cuántas consultas simultáneas al proveedor como máximo. Subirlo acelera los
# ciclos con muchos partidos, a costa de arriesgar la limitación de tasa.
SYNC_CONCURRENCIA=4

# Cuánto se espera como máximo una respuesta de APIFootball. NO lo pongas en 0:
# ese es el valor por defecto de axios y significa "esperar para siempre". Una
# petición colgada dejaría el ciclo de sincronización sin terminar nunca y el
# auto-sync de esa instancia se apagaría en silencio hasta el reinicio.
APIFOOTBALL_TIMEOUT_MS=15000

# Cuánto se espera como máximo a que termine un ciclo completo antes de darlo
# por perdido y dejar el planificador libre. Debe ser MENOR que los cinco
# minutos de vida del cerrojo, para que el cerrojo del ciclo abandonado ya esté
# caducado cuando el siguiente lo pida.
SYNC_TIMEOUT_CICLO_MS=240000

# Si esta instancia ejecuta los trabajos periódicos (sincronización y
# resolución de trivias). Un cerrojo en la base impide que varias instancias los
# dupliquen, así que puede quedarse en 'true' en todas. Ponlo en 'false' cuando
# quieras que unas instancias solo atiendan peticiones y otra haga de
# trabajador.
JOBS_HABILITADOS=true

# --- Ranking (Fase 5) ---

# Cuánto tiempo puede vivir en memoria la tabla de posiciones por quiniela.
# Cada cambio relevante la invalida inmediatamente; este TTL es una red de
# seguridad para futuras vías de escritura. Por defecto: 60 segundos.
RANKING_CACHE_TTL_MS=60000

# --- Solo para scripts/migrate-legacy.js ---
# La credencial antigua DEBE tener permisos exclusivamente de lectura.
# El script rechaza que el origen y el destino sean la misma base.
# ⚠️ Éstas son las ÚNICAS variables de Mongo que quedan: el migrador es lo único
# que sigue hablando con la base anterior. La aplicación ya no la toca.
MONGO_URI_MULTIQUINIELA=mongodb+srv://usuario:clave@cluster/nueva_base
MONGO_URI_LEGACY_READONLY=mongodb+srv://lector:clave@cluster/base_anterior
LEGACY_DB_NAME=base_anterior
TARGET_DB_NAME=nueva_base
MIGRATION_OWNER_EMAIL=propietario-ya-registrado@ejemplo.com
MIGRATION_POOL_NAME=Quiniela histórica

# =====================================================================
# CORREO — Fase E (verificación de la dirección)
# =====================================================================
#
# ⛔ La cuenta nace SIN CONFIRMAR y sin confirmar no se entra. Si el correo
#    no sale, nadie puede usar la aplicación.
#
# Transporte:
#   consola  escribe el correo en el registro en vez de enviarlo, y lo deja
#            en una bandeja en memoria. Es el predeterminado, y el que usan
#            las pruebas: del token sólo se guarda el hash, así que sin esa
#            bandeja no habría forma de recuperar el enlace.
#   brevo    envía de verdad. Se eligió porque permite verificar UNA sola
#            dirección de remitente sin poseer un dominio.
#   resend   escrito por adelantado para el día que haya dominio propio.
#            Exige verificarlo con registros DNS; a cambio la entregabilidad
#            es muy superior.
MAIL_TRANSPORT=consola

# La clave del proveedor. En desarrollo no hace falta: con el transporte de
# consola no se envía nada.
MAIL_API_KEY=

# ⚠️ Tiene que ser la dirección verificada en el proveedor. Si no lo es, el
# envío falla y el error del proveedor lo dice.
MAIL_FROM=
MAIL_FROM_NAME=Quiniela Deportiva Global

# De dónde cuelga el enlace del correo. En producción, el dominio real; sin
# esto apuntaría a localhost y el enlace no le serviría a nadie.
APP_ORIGIN=http://localhost:3000

# Cuánto vive el enlace de confirmación.
VERIFY_TOKEN_HOURS=24

# ⚠️ Y cuánto vive el de restablecer la contraseña, que es MUCHO más corto a
# propósito: ese enlace abre la cuenta a quien lo tenga, así que un correo viejo
# olvidado en una bandeja es una llave. Confirmar una dirección no tiene ese
# riesgo, y por eso el otro dura un día.
RESET_TOKEN_HOURS=1

# ---------------------------------------------------------------------------
# EL SUPERADMINISTRADOR DEL SISTEMA
# ---------------------------------------------------------------------------
#
# Correos separados por comas. Quien esté aquí puede ver TODAS las cuentas del
# sistema —correo, estado, y a qué quinielas pertenece cada quien— y retirarlas.
#
# ⛔ ESTO NO VIVE EN LA BASE, Y ES DELIBERADO. Con una columna `es_superadmin`,
#    cualquiera que llegue a serlo podría nombrar a otro desde la propia
#    pantalla, y una cuenta comprometida se volvería permanente. Aquí hace falta
#    entrar al panel de Render: el poder total no se concede desde dentro de la
#    aplicación. Es la misma lógica que impide que la app use el rol dueño.
#
# Vacío o sin poner = NADIE es superadministrador, y la pantalla no deja entrar.
# El fallo por defecto es cerrado, que es el único aceptable para esta puerta.
#
# ⚠️ Además del correo hace falta que la cuenta esté ACTIVA y CONFIRMADA, y
#    volver a escribir la contraseña cada hora: una sesión olvidada en un
#    teléfono no puede ser la llave para borrar cuentas del sistema.
SUPERADMIN_EMAILS=
